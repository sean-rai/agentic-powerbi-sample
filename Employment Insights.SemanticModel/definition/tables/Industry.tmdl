	column 'Industry (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Industry'[Industry]),
				"(Blank)",
				'Industry'[Industry] IN {"Construction"},
				"Construction",
				'Industry'[Industry] IN {"Financial & insurance activities",
					"Information & communication",
					"Professional, scientific & technical activities",
					"Real estate activities"},
				"Knowledge Services",
				'Industry'[Industry] IN {"Accommod-ation & food services",
					"Administrative & support services",
					"Other services",
					"Transport & storage",
					"Wholesale, retail & repair of motor vehicles"},
				"Market Services",
				'Industry'[Industry] IN {"Agriculture, forestry & fishing",
					"Manufacturing",
					"Mining, energy and water supply"},
				"Production",
				'Industry'[Industry] IN {"Education",
					"Human health & social work activities",
					"Public admin & defence; social security"},
				"Public Sector",
				'Industry'[Industry]
			)
		lineageTag: 99e54f8b-ccf9-4f16-a6c0-25fb78c7d774
		summarizeBy: none

